# Hermes CLI --temperature patch
# =================================
# Adds --temperature flag to `hermes chat` so ObserveCo's canary benchmark can
# control sampling temperature per task.
#
# Files touched (all in ~/.hermes/hermes-agent/):
#   - cli.py                          (HermesCLI.__init__ + cli_main signature)
#   - hermes_cli/_parser.py           (chat subparser --temperature arg)
#   - hermes_cli/cli_agent_setup_mixin.py (_init_agent merges into request_overrides)
#   - hermes_cli/main.py              (cmd_chat passes temperature to cli_main)
#
# Re-apply after a Hermes update:
#   cd ~/.hermes/hermes-agent
#   git apply /Users/seanfzc/projects/observeco/patches/hermes-cli-temperature.patch
#
# If the patch fails (context shifted), re-do the 4 edits manually — they are
# small and isolated (see the diff below for exact anchors).
# =================================

diff --git a/cli.py b/cli.py
index 069b3c616..983423b71 100644
--- a/cli.py
+++ b/cli.py
@@ -3694,6 +3694,7 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin):
         checkpoints: bool = False,
         pass_session_id: bool = False,
         ignore_rules: bool = False,
+        temperature: float | None = None,
     ):
         """
         Initialize the Hermes CLI.
@@ -3901,6 +3902,12 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin):
         # pass skip_context_files=True and skip_memory=True to AIAgent so
         # AGENTS.md/SOUL.md/.cursorrules and persistent memory are not loaded.
         self.ignore_rules = ignore_rules or os.environ.get("HERMES_IGNORE_RULES") == "1"
+
+        # --temperature: when set, override the model's sampling temperature
+        # for this run via request_overrides (merged into the API call kwargs
+        # by the chat_completions transport). ponytail: temperature is a
+        # per-agent-run setting, not per-turn — re-init clears it.
+        self.temperature = temperature
         
         # Ephemeral system prompt: env var takes precedence, then config
         self.system_prompt = (
@@ -15778,6 +15785,7 @@ def main(
     pass_session_id: bool = False,
     ignore_user_config: bool = False,
     ignore_rules: bool = False,
+    temperature: float | None = None,
 ):
     """
     Hermes Agent CLI - Interactive AI Assistant
@@ -15913,6 +15921,7 @@ def main(
         checkpoints=checkpoints,
         pass_session_id=pass_session_id,
         ignore_rules=ignore_rules,
+        temperature=temperature,
     )
 
     if parsed_skills:
