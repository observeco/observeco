+            # Merge --temperature into request_overrides (if any) so the
+            # chat_completions transport applies it to the API call. CLI flag
+            # wins over any temperature already present in request_overrides.
+            if getattr(self, "temperature", None) is not None:
+                _ro = dict(request_overrides or {})
+                _ro["temperature"] = self.temperature
+                request_overrides = _ro
+
             effective_model = model_override or self.model
             self.agent = AIAgent(
                 model=effective_model,
